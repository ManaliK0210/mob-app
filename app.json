{
  "expo": {
    "name": "Forkcast",
    "slug": "forkcast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.forkcast.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2542D"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.forkcast.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "aiProxyUrl": "https://forkcast-ai.manalik0210.workers.dev"
    }
  }
}
